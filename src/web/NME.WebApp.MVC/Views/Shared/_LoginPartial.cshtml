﻿@using NME.WebApp.MVC.Interfaces;
@inject IUser AppUser

@if (AppUser.Autenticado())
{
    <ul class="navbar-nav align-items-lg-center gap-lg-2">

        <li class="nav-item">
            <span class="nav-link text-dark fw-semibold text-truncate" style="max-width:260px;">
                Olá @AppUser.ObterUserEmail()
            </span>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Identidade" asp-action="MinhaConta">Meus dados</a>
        </li>

        <li class="nav-item">
            <form asp-controller="Identidade" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-danger border-0 p-0 px-2">Sair</button>
            </form>
        </li>

    </ul>
}
else
{
    <ul class="navbar-nav align-items-lg-center gap-2">

        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm px-3 rounded-3 fw-semibold"
               asp-controller="Identidade" asp-action="Registro">
                Criar sua conta
            </a>
        </li>

        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3 rounded-3 fw-semibold"
               asp-controller="Identidade" asp-action="Login">
                Login
            </a>
        </li>

    </ul>
}