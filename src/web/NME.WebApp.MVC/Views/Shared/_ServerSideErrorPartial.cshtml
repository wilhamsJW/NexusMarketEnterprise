﻿@{
// Rota de retorno: cai na action atual quando o chamador não informa ViewData["RetryAction"]
var retryAction = ViewData["RetryAction"] as string ?? ViewContext.RouteData.Values["action"]?.ToString();
var retryController = ViewData["RetryController"] as string ?? ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="card border-0 shadow-lg rounded-3 overflow-hidden">

    <div class="card-header border-0 text-center text-white py-4 bg-warning-subtle">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning text-dark mb-2 p-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
            </svg>
        </div>
        <h4 class="fw-bold mb-0 text-dark">Instabilidade temporária</h4>
    </div>

    <div class="card-body p-4 p-lg-5 text-center">

        <p class="text-muted mb-1">
            Não conseguimos falar com o serviço de identidade neste momento.
        </p>
        <p class="text-muted small mb-4">
            Nenhum dado foi perdido. Já estamos cientes e o serviço deve voltar em instantes.
        </p>

        <div class="d-grid gap-2">
            <a class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm"
               asp-controller="@retryController" asp-action="@retryAction">
                Tentar novamente
            </a>
            <a class="btn btn-link text-muted text-decoration-none" asp-controller="Home" asp-action="Index">
                Voltar para a página inicial
            </a>
        </div>

    </div>
</div>